# Kalshi API - NEW ENDPOINT (as of late 2024)
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi-private-key.pem

# Trading Mode - ALWAYS START IN PAPER MODE
PAPER_TRADING_MODE=true
PAPER_STARTING_BALANCE=10000.00

# CF Benchmarks (for crypto spot prices)
CF_BENCHMARKS_API_URL=https://www.cfbenchmarks.com/api

# Application Settings
DATABASE_PATH=./data/kalshi_arb.db
LOG_LEVEL=INFO
