# Kalshi API (single production endpoint)
KALSHI_API_URL=https://trading-api.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi-private-key.pem

# Trading Mode
# true = paper (simulate locally, safe)
# false = live (real money!)
PAPER_TRADING_MODE=true
PAPER_STARTING_BALANCE=10000.00

# Spot Prices
CF_BENCHMARKS_API_URL=https://www.cfbenchmarks.com/api

# App
DATABASE_PATH=./data/kalshi_arb.db
LOG_LEVEL=INFO
