# Kalshi API Configuration
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi-private-key.pem

# Trading Mode (IMPORTANT: Keep True until ready for live trading!)
PAPER_TRADING_MODE=True
PAPER_STARTING_BALANCE=10000.00

# Database
DATABASE_PATH=./data/kalshi_arb.db
LOG_LEVEL=INFO

# Note: Spot price fetching uses free APIs (CoinGecko/CoinLore)
# No configuration needed - works out of the box
