# Kalshi API Configuration
KALSHI_ENV=demo
KALSHI_DEMO_API_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_PROD_API_URL=https://trading-api.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi-private-key.pem

# CF Benchmarks (for crypto spot prices)
CF_BENCHMARKS_API_URL=https://www.cfbenchmarks.com/api

# Application Settings
LOG_LEVEL=INFO
DATABASE_PATH=./data/kalshi_arb.db

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
